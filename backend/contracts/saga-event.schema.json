{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commerce.example/contracts/saga-event-v1",
  "title": "Commerce saga event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "aggregateId",
    "occurredAt",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "enum": [
        "OrderPlaced",
        "InventoryReserved",
        "InventoryRejected",
        "PaymentAuthorized",
        "PaymentFailed",
        "OrderConfirmed",
        "OrderCancelled"
      ]
    },
    "schemaVersion": {
      "const": 1
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  },
  "description": "Kafka key equals aggregateId and payload.orderId. Only trusted domain producers may publish. Consumers additionally enforce state, owner and amount invariants.",
  "$defs": {
    "placed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orderId",
        "userId",
        "items",
        "expiresAt"
      ],
      "properties": {
        "orderId": {
          "type": "string",
          "format": "uuid"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sku",
              "quantity"
            ],
            "properties": {
              "sku": {
                "type": "string",
                "pattern": "^[A-Z0-9_-]{1,64}$"
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              }
            }
          }
        }
      }
    },
    "reserved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orderId",
        "userId",
        "totalMinor",
        "currency",
        "expiresAt"
      ],
      "properties": {
        "orderId": {
          "type": "string",
          "format": "uuid"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "totalMinor": {
          "type": "integer",
          "minimum": 1
        },
        "currency": {
          "const": "USD"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "authorized": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orderId",
        "userId",
        "paymentId",
        "totalMinor",
        "currency"
      ],
      "properties": {
        "orderId": {
          "type": "string",
          "format": "uuid"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "paymentId": {
          "type": "string",
          "minLength": 1
        },
        "totalMinor": {
          "type": "integer",
          "minimum": 1
        },
        "currency": {
          "const": "USD"
        }
      }
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orderId",
        "userId"
      ],
      "properties": {
        "orderId": {
          "type": "string",
          "format": "uuid"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reason": {
          "type": "string",
          "maxLength": 200
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "OrderPlaced"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/placed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "InventoryReserved"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/reserved"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "PaymentAuthorized"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/authorized"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "InventoryRejected"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/terminal"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "PaymentFailed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/terminal"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "OrderConfirmed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/terminal"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "OrderCancelled"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/terminal"
          }
        }
      }
    }
  ]
}
